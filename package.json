{
  "name": "BullsAndCows",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "webpack.base.config.js",
  "scripts": {
    "start": "webpack serve --open --config ./webpack.config.js --env mode=dev",
    "build": "webpack --config ./webpack.config.js --env mode=prod",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check --ignore-unknown",
    "format:fix": "prettier . --write",
    "test": "jest tests",
    "test:generate-sec": "jest tests/generateSecret.test.ts",
    "test:count-pos": "jest tests/countPossibleSecrets.test.ts",
    "test:is-valid": "jest tests/isValidGuess.test.ts",
    "test:create-dig": "jest tests/createDigitValidator.test.ts",
    "test:eval": "jest tests/evaluateGuess.test.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,ts}": "eslint",
    "**/*.{ts,js,html,json,css,md}": "prettier --check --ignore-unknown"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [],
  "author": "Alexandra Ro",
  "homepage": "",
  "devDependencies": {
    "@types/eslint__js": "^8.42.3",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.10.0",
    "dotenv-webpack": "^8.0.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "gh-pages": "^6.3.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "style-loader": "^3.3.4",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.90.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^5.10.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
